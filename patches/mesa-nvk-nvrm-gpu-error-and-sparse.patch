+   int64_t live = p_atomic_add_return(&nvrm_gart_live_bytes, dir * (int64_t)size);
+   static int report_growth = -1;
+   if (report_growth < 0)
+      report_growth = getenv("NVK_NVRM_VA_LOG") != NULL;
+   if (report_growth && dir > 0 && (uint64_t)live >= nvrm_gart_reported + (512ull << 20)) {
+      nvrm_gart_reported = (uint64_t)live;
+      nvrm_gart_report("grew by 512 MB");
+   }
+}
+
+static void
+nvrm_va_event(uint32_t what, uint64_t addr, uint64_t size, uint32_t flags, uint32_t handle)
+{
+   if ((flags & 8) && (what == 1 || what == 2))
+      nvrm_gart_account(size, what == 1 ? 1 : -1);
+   static int log_all = -1;
+   if (log_all < 0)
+      log_all = getenv("NVK_NVRM_VA_LOG") != NULL;
+   if (log_all && (what == 1 || what == 3))
+      fprintf(stderr, "NVK nvrm: va %s %#" PRIx64 " +%#" PRIx64 " flags=%x\n", what == 1 ? "ALLOC" : "BIND", addr, size, flags);
+   uint32_t i = p_atomic_inc_return(&nvrm_va_event_next) - 1;
+   struct nvrm_va_event *e = &nvrm_va_events[i % NVRM_VA_EVENTS];
+   e->t_ns = os_time_get_nano();
+   e->addr = addr;
+   e->size = size;
+   e->what = what;
+   e->tid = (uint32_t)(uintptr_t)pthread_self();
+   e->flags = flags;
+   e->handle = handle;
+}
+
+void
+nvkmd_nvrm_dump_va_events(void)
+{
+   static const char *names[] = {"?", "ALLOC", "FREE", "BIND", "UNBIND"};
+   const uint32_t next = p_atomic_read(&nvrm_va_event_next);
+   const uint32_t count = next < NVRM_VA_EVENTS ? next : NVRM_VA_EVENTS;
+   nvrm_gart_report("at the fault");
+   fprintf(stderr, "NVK nvrm: va events: %u of %u (oldest first)\n", count, next);
+   for (uint32_t k = 0; k < count; k++) {
+      const uint32_t i = next - count + k;
+      const struct nvrm_va_event *e = &nvrm_va_events[i % NVRM_VA_EVENTS];
+      fprintf(stderr, "NVK nvrm: va #%u t=%.6f tid=%x %s %#" PRIx64 " +%#" PRIx64 " flags=%x handle=%#x\n", i, e->t_ns / 1e9, e->tid,
+              names[e->what < 5 ? e->what : 0], e->addr, e->size, e->flags, e->handle);
+   }
+   fflush(stderr);
+}
