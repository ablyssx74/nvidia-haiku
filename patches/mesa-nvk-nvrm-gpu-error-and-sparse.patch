+
+/* Haiku: the channel's error notifier is filled in by the resource manager when the GPU channel dies (an MMU fault, a hung engine,
+ * ...). The flush used to poll for ever for the semaphore of a channel that can never write it again, so a program that
+ * triggered a GPU fault hung inside vkQueueSubmit() (and could take the machine with it when it was closed). Look at the
+ * notifier on every round, give up after NVK_NVRM_TIMEOUT_MS (default 30 s, 0 = never) and report VK_ERROR_DEVICE_LOST. */
+static const char *
+nvrm_channel_error_name(uint32_t code)
+{
+   switch (code) {
+   case ROBUST_CHANNEL_GR_EXCEPTION: return "GR_EXCEPTION";
+   case ROBUST_CHANNEL_FIFO_ERROR_MMU_ERR_FLT: return "MMU_FAULT";
+   case ROBUST_CHANNEL_PBDMA_ERROR: return "PBDMA_ERROR";
+   case ROBUST_CHANNEL_PREEMPTIVE_REMOVAL: return "PREEMPTIVE_REMOVAL";
+   default: return "unknown";
+   }
+}
+
+static uint64_t
+nvrm_gpu_timeout_ns(void)
+{
+   static int64_t ms = -1;
+   if (ms < 0) {
+      const char *e = getenv("NVK_NVRM_TIMEOUT_MS");
+      ms = e ? atoll(e) : 30000;
+      if (ms < 0) ms = 30000;
+   }
+   return (uint64_t)ms * 1000000ull;
+}
